# Copy this file to .env in the repo root and fill in real values.
# .env is already git-ignored (see .gitignore) — it will never be committed.

# Particle Health sandbox credentials.
# Get these from your Particle Health dashboard / account rep.
PARTICLE_CLIENT_ID=
PARTICLE_CLIENT_SECRET=

# Optional — only needed if your Particle rep gave you a specific project scope.
# PARTICLE_SCOPE=projects/your-project-id
